# Copy to .env.local
# Session signing secret (any random string, 32+ chars)
AUTH_SECRET=

# Postgres
DATABASE_URL=

# Public base URL of this app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web-first data routing
# DataForSEO (https://dataforseo.com) — HTTP Basic auth
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
YUTE_DFSEO_LOCATION=2840
YUTE_DFSEO_LANGUAGE=en

# LLM extraction (optional — heuristic extraction runs for free without it).
# Pick one operator; defaults to heuristic-only if none is set.
# LLM_PROVIDER=gemini|groq|deepseek|openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Internal email validation (SMTP RCPT). Use a real mailbox/domain you control.
YUTE_VERIFY_FROM=verify@yute.dev

# Paid finder fallback — set whichever one(s) you have; cheapest first.
PROSPEO_API_KEY=
FINDYMAIL_API_KEY=
HUNTER_API_KEY=

# Credits / metering
YUTE_CREDIT_MICRO_USD=50000
YUTE_CACHE_HIT_CREDITS=1
YUTE_RATE_LIMIT_PER_MIN=60
YUTE_MAX_COST_MICRO_USD=200000
# Admin top-up secret for POST /v1/credits
YUTE_ADMIN_SECRET=
# Allow webhook delivery to private/localhost URLs (testing only)
YUTE_ALLOW_PRIVATE_WEBHOOKS=false
# Async job recovery: requeue "running" jobs older than this, then refund after max attempts
YUTE_JOB_STALE_MS=300000
YUTE_JOB_MAX_ATTEMPTS=3
# Allow the /api/selftest billing smoke test to run in production (default: off)
YUTE_SELFTEST_ALLOW_PROD=false

# Email (Resend) — password reset + welcome
RESEND_API_KEY=
YUTE_EMAIL_FROM=yute <no-reply@yute.dev>

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth (sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Queue (durable async jobs via pg-boss on the same Postgres). Set to "off" to disable.
YUTE_QUEUE=on

# Error reporting (Sentry, optional)
SENTRY_DSN=

# Admin access (comma-separated emails)
YUTE_ADMIN_EMAILS=

# Phone providers (set whichever you use; see providers.json)
LEADMAGIC_API_KEY=
ONELOOKUP_API_KEY=
# Phone billing: credits per confirmed phone (default 10x an email)
YUTE_PHONE_CREDIT_MULTIPLIER=10

# Config-driven HTTP providers (optional). Defaults to ./providers.json
# YUTE_PROVIDERS_JSON='{"providers":[]}'
# Multiple Clay routines per query type (optional)
# CLAY_ROUTINES={"email":"function:t_...","domain":"function:t_..."}

# Clay as optional last-resort provider (BYOK).
# CLAY_ROUTINE_ID is the routine that returns contact data
# (e.g. "Enrich Person and Find Contact Details"); discover it with `clay routines list`.
CLAY_API_KEY=
CLAY_ROUTINE_ID=
CLAY_API_BASE=https://api.clay.com/public/v0
# Map Clay routine input field name -> yute token (email|domain|name|company|firstName|lastName)
CLAY_INPUTS={"Email":"email","domain":"domain","full_name":"name"}
CLAY_COST_MICRO_USD=20000
CLAY_TIMEOUT_MS=30000
